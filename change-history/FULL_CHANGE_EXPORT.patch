diff --git a/snippets/custom-free-product-variant.liquid b/snippets/custom-free-product-variant.liquid
new file mode 100644
index 0000000..2c106d5
--- /dev/null
+++ b/snippets/custom-free-product-variant.liquid
@@ -0,0 +1,18 @@
+{% comment %}
+  Outputs the variant ID for a free gift product.
+  Prefers variant with "Free" in title/options, else first available.
+  Usage: {% capture vid %}{% render 'custom-free-product-variant', product: some_product %}{% endcapture %}
+{% endcomment %}
+{% assign custom_free_vid = nil %}
+{% if product and product != blank %}
+  {% for v in product.variants %}
+    {% if v.option1 == 'Free' or v.option2 == 'Free' or v.option3 == 'Free' or v.title == 'Free' %}
+      {% assign custom_free_vid = v.id %}
+      {% break %}
+    {% endif %}
+  {% endfor %}
+  {% if custom_free_vid == nil and product.selected_or_first_available_variant %}
+    {% assign custom_free_vid = product.selected_or_first_available_variant.id %}
+  {% endif %}
+{% endif %}
+{{ custom_free_vid }}
diff --git a/snippets/free-gift-progress.liquid b/snippets/free-gift-progress.liquid
new file mode 100644
index 0000000..2e93e05
--- /dev/null
+++ b/snippets/free-gift-progress.liquid
@@ -0,0 +1,27 @@
+{% comment %}
+  Free gift progress bar. Renders when free products are configured.
+{% endcomment %}
+{%- liquid
+  assign has_free_products = false
+  if settings.custom_free_product_1 != blank or settings.custom_free_product_2 != blank or settings.custom_free_product_3 != blank
+    assign has_free_products = true
+  endif
+  assign goal_euros = settings.custom_integer | default: 0
+-%}
+{%- if has_free_products and goal_euros > 0 -%}
+  {%- assign goal_cents = goal_euros | times: 100 -%}
+  <div class="free-gift-progress-wrapper cart-notice text-size--small hide-if-empty-cart">
+    <free-gift-progress
+      class="free-gift-progress"
+      data-goal="{{ goal_cents }}"
+      data-cart-total="{{ cart.total_price | default: 0 }}"
+      data-text-remaining="Noch %amount% bis zu Ihrem Gratisgeschenk"
+      data-text-qualified="Sie haben sich ein Gratisgeschenk verdient!"
+    >
+      <span data-js-free-gift-text class="free-gift-progress__text"></span>
+      <span class="free-gift-progress__slider cart-notice__slider">
+        <span class="free-gift-progress__bar cart-notice__slider-bar" data-js-free-gift-slider></span>
+      </span>
+    </free-gift-progress>
+  </div>
+{%- endif -%}
