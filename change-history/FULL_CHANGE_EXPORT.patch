+  <html id="html" class="no-js" lang="{{ request.locale.iso_code }}" dir="{{ direction }}">
+  <head>{% render "load-metafields" %}
+  
+    <meta charset="utf-8">
+    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
